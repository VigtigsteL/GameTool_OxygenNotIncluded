//Health:OnHealthChanged+84
{$lua}
LaunchMonoDataCollector()
mono_symbolLookupCallback("Health:OnHealthChanged")
{$asm}

define(address,"Health:OnHealthChanged"+84)
define(bytes,F3 0F 10 40 48 F3 0F 5A C0 F2 0F 5A E8 F3 0F 11 6D B4)

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

 
 
assert(address,bytes)
alloc(newmem,$1000,"Health:OnHealthChanged")

label(code)
label(return)

newmem:

code:
  mov [rax+48],(float)100
  movss xmm0,[rax+48]
  cvtss2sd xmm0,xmm0
  cvtsd2ss xmm5,xmm0
  movss [rbp-4C],xmm5
  jmp return

address:
  jmp far newmem
  nop 4
return:

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
address:
  db bytes
  // movss xmm0,[rax+48]
  // cvtss2sd xmm0,xmm0
  // cvtsd2ss xmm5,xmm0
  // movss [rbp-4C],xmm5

dealloc(newmem)

{
